# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Business Information
BUSINESS_NAME=Premium Cleaning Services
BUSINESS_PHONE=+61 2 1234 5678
BUSINESS_EMAIL=hello@cleaningservices.com.au
BUSINESS_ADDRESS=Sydney, NSW 2000, Australia
WHATSAPP_NUMBER=61412345678

# Email Configuration
# For testing/development: use django.core.mail.backends.console.EmailBackend
# For production: use django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Gmail SMTP Configuration (for production)
# Get app password from: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-from-google
DEFAULT_FROM_EMAIL=your-email@gmail.com
